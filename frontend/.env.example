# ==============================================================================
# KLU Assignment Tracker Frontend — Production Environment Variables Example
# Set these variables in your frontend deployment platform (e.g. Vercel / Netlify / Render)
# ==============================================================================

# Backend API base URL
# Leave empty or omit during local development to use Vite's dev proxy (/api).
# In production, set to your deployed backend URL:
# Example: https://klu-tracker-api.onrender.com
VITE_API_BASE_URL=

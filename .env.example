# ==============================================================================
# KLU Assignment Tracker — Production Environment Variables Example
# Copy this file to .env and provide your actual production configuration values.
# NEVER commit .env with real secret credentials to version control.
# ==============================================================================

# ── Backend Configuration ────────────────────────────────────────────────────
# Port for the Spring Boot server (cloud providers usually set this automatically)
PORT=8081

# Full MongoDB Atlas connection URI with database name and authSource
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/klu_assignment_tracker?authSource=admin&retryWrites=true&w=majority
MONGODB_URI=

# Strong random secret key for signing JWT tokens (min 32 characters / 256 bits)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# JWT token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Allowed Frontend URL(s) for CORS (comma-separated or single domain)
# Example: https://klu-tracker.vercel.app
FRONTEND_URL=

# Web Push / VAPID Keys
# Generate with: ./mvnw compile exec:java -Dexec.mainClass=com.klu.assignmenttracker.GenerateVapidKeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# KLU Moodle LMS Web Service Endpoints (default values work out-of-the-box)
LMS_TOKEN_URL=https://lms.kluniversity.in/login/token.php
LMS_REST_URL=https://lms.kluniversity.in/webservice/rest/server.php
LMS_SERVICE=moodle_mobile_app
LMS_TIMEOUT_SECONDS=15

# Automatic Background LMS Sync interval (minutes)
SYNC_INTERVAL_MINUTES=30
